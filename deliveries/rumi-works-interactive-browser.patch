+++ b/ios-rumi/Rumi/WorksBridge.swift
@@ -0,0 +1,170 @@
+import Foundation
+import WebKit
+
+struct WorksObservation: Codable {
+    struct Element: Codable {
+        let ref: Int
+        let tag: String
+        let name: String
+        let type: String
+        let value: String
+        let href: String
+        let sensitive: Bool
+        let x: Double
+        let y: Double
+    }
+    let document: String
+    let revision: Int
+    let url: String
+    let title: String
+    let text: String
+    let elements: [Element]
+    let width: Double
+    let height: Double
+    let scrollX: Double
+    let scrollY: Double
+    let blockedFrames: Int
+    let sensitive: Bool
+    func json() throws -> String { String(decoding: try JSONEncoder().encode(self), as: UTF8.self) }
+}
+struct WorksAction: Codable {
+    let kind: String
+    let ref: Int?
+    let text: String?
+    let url: String?
+    let direction: String?
+    let x: Double?
+    let y: Double?
+    let summary: String
+    var needsApproval: Bool { ["click", "type_text", "select_option", "navigate", "visual_click"].contains(kind) }
+}
+
+/// Runs in a named isolated world: sites share DOM, not these references or message handlers.
+@MainActor enum WorksBridge {
+    static let world = WKContentWorld.world(name: "RumiAgent")
