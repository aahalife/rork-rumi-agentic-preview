+    @Test func persistenceRemainsBackwardCompatible() throws {
+        let old = Data("{\"role\":\"assistant\",\"text\":\"Hello\",\"id\":\"00000000-0000-0000-0000-000000000001\",\"kind\":\"conversation\"}".utf8)
